# Copia este archivo a .env (Bun lo carga solo; en Node usa `npm run start:node`).
# Los secretos de la cartera del agente NO van aquí si el agente corre en otra máquina:
# este archivo es para el proceso que cobra (el servicio) y, si aplica, para el puente MCP.

# --- Cobro (obligatorio) -----------------------------------------------------
# Redes en las que quieres cobrar, separadas por comas (formato CAIP-2).
# Se puede cobrar en las dos a la vez: el agente elige con qué cartera paga.
#   pruebas:    eip155:84532 (Base Sepolia), solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1 (devnet)
#   producción: eip155:8453 (Base), solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp (Solana)
X402_NETWORKS=eip155:84532

# Una dirección de cobro por familia de red (las que uses en X402_NETWORKS):
X402_PAY_TO=0x0000000000000000000000000000000000000000   # EVM (Base)
# X402_PAY_TO_SVM=                                          # Solana (base58)

# Precio por petición (no por archivo), igual en todas las redes. Ej.: $0.02, $0.50
# Sin "$": el cargador de .env de Bun expande variables y "$0" se perdería.
X402_PRICE=0.02

# --- Token con el que cobras (opcional) -------------------------------------
# Por defecto se cobra el USDC de cada red. Para cobrar otro token:
#   EVM:    X402_ASSET=<contrato ERC-20> + X402_ASSET_EXTRA={"name":"...","version":"..."}
#           Tiene que soportar EIP-3009 (transferWithAuthorization): USDC, PYUSD,
#           USDP, FDUSD, USDT0. El USDT clásico NO lo soporta.
#   Solana: X402_ASSET_MINT=<mint SPL>, vale cualquiera (USDC, USDT...).
X402_ASSET_DECIMALS=6
# X402_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# X402_ASSET_EXTRA={"name":"USD Coin","version":"2"}
# X402_ASSET_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB

# Facilitador que verifica y liquida el pago.
#   pruebas:    https://x402.org/facilitator   (Base Sepolia + Solana devnet)
#   producción: el facilitador de tu proveedor (Coinbase CDP, PayAI, Corbits...)
X402_FACILITATOR_URL=https://x402.org/facilitator

# Si tu facilitador pide autenticación (p.ej. CDP), apunta aquí a un módulo que
# exporte `createAuthHeaders(operation)`. Ejemplo: ./auth-cdp.js
# X402_FACILITATOR_AUTH_MODULE=

# RPC de Solana: si lo defines, el reto 402 lleva un blockhash reciente y el
# agente se ahorra una consulta a su propio RPC.
# X402_SVM_RPC_URL=https://api.devnet.solana.com

# --- Registro de ventas (recomendado en producción) -------------------------
# Una línea JSON por cobro liquidado (fecha, importe, red, pagador, tx) y otra
# por cada liquidación fallida. Sin esta variable no escribe nada.
LEDGER_FILE=ventas.jsonl

# --- Servidor ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8402
SERVICE_NAME=quitametadatos
# URL pública, si publicas el servicio detrás de un túnel o proxy
# PUBLIC_URL=

# Límites por petición
MAX_FILES=10
MAX_FILE_BYTES=33554432
MAX_REQUEST_BYTES=67108864
MAX_JSON_OUTPUT_BYTES=8388608

# --- Lado que paga (puente MCP: `npm run mcp`) ------------------------------
# URL del servicio que cobra
# SERVICIO_URL=https://tu-servicio.example.com

# Opción 1: cartera de servidor de Privy (recomendado; sin claves privadas aquí)
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# PRIVY_WALLET_ID=
# PRIVY_WALLET_ADDRESS=

# Opción 2: claves locales — EVM (Base) y/o Solana. Con las dos, el agente puede
# pagar en cualquiera de las redes que acepte el servicio.
# EVM_PRIVATE_KEY=
# SVM_PRIVATE_KEY=                      # clave secreta de Solana en base58
# SVM_RPC_URL=https://api.mainnet-beta.solana.com

# Red preferida cuando el agente tiene cartera en las dos (CAIP-2)
# X402_PREFERIR_RED=eip155:8453

# Tope de gasto por pago, en dólares. El SDK ya trae 1 USD por defecto; aquí se deja explícito.
MAX_USD_POR_PAGO=1

# Si el servicio cobra en un token que el SDK no reconoce, el cliente se niega a
# pagarlo salvo que lo autorices aquí, como "red=token" (varias, separadas por comas).
# X402_ASSETS_PERMITIDOS=eip155:8453=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
