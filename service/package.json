{
  "name": "metaclean-agent-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de limpieza de metadatos con cobro x402, para agentes de IA",
  "scripts": {
    "catalogado": "bun run src/catalogado.js",
    "pagar": "bun run src/pagar.js",
    "saldo": "bun run src/saldo.js",
    "cartera": "bun run src/nueva-cartera.js",
    "preflight": "bun run src/preflight.js",
    "preflight:node": "node --env-file-if-exists=.env src/preflight.js",
    "start": "bun run src/server.js",
    "start:node": "node --env-file-if-exists=.env src/server.js",
    "mcp:sell": "bun run src/mcp-service.js",
    "mcp:sell:node": "node --env-file-if-exists=.env src/mcp-service.js",
    "mcp": "bun run src/mcp.js",
    "mcp:node": "node --env-file-if-exists=.env src/mcp.js",
    "test": "bun test/e2e.js",
    "test:mcp": "bun test/mcp.js",
    "test:svm": "bun test/e2e-svm.js",
    "test:fixtures": "bun test/verify-fixtures.js",
    "test:all": "bun test/e2e.js && bun test/e2e-svm.js && bun test/e2e-asset.js && bun test/preflight.js && bun test/mcp.js && bun test/verify-fixtures.js",
    "test:asset": "bun test/e2e-asset.js",
    "test:preflight": "bun test/preflight.js",
    "prueba:testnet": "bun test/live-testnet.js",
    "prueba:testnet:node": "node test/live-testnet.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "@privy-io/node": "^0.34.0",
    "@solana-program/token-2022": "0.6.1",
    "@solana/kit": "5.5.1",
    "@x402/core": "^2.26.0",
    "@x402/evm": "^2.26.0",
    "@x402/extensions": "^2.26.0",
    "@x402/fetch": "^2.26.0",
    "@x402/hono": "^2.26.0",
    "@x402/mcp": "^2.26.0",
    "@x402/svm": "^2.26.0",
    "@xmldom/xmldom": "^0.9.12",
    "hono": "^4.10.2",
    "viem": "^2.56.7",
    "zod": "^3.25.76"
  }
}
