# Configuración de nginx para el front. ${PORT} lo sustituye la imagen oficial
# de nginx al arrancar (envsubst sobre /etc/nginx/templates).
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Al ser estático, cualquier ruta desconocida vuelve al index (la app es una
    # sola página).
    location / {
        try_files $uri $uri/ /index.html;
    }

    # El service worker nunca se cachea: si no, una versión vieja se queda pegada
    # en el navegador del usuario.
    location = /sw.js {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # El manifest tampoco (cambia con cada versión).
    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
    }

    # Los recursos con hash o estáticos sí pueden cachearse un rato.
    location ~* \.(css|js|png|webp|svg|woff2?)$ {
        add_header Cache-Control "public, max-age=3600";
    }

    # Comprime lo que se pueda; la app es texto.
    gzip on;
    gzip_types text/html text/css application/javascript application/json image/svg+xml;
    gzip_min_length 512;

    add_header X-Content-Type-Options "nosniff";
    add_header Referrer-Policy "no-referrer";

    # Nada de esto aplica: la app no sube archivos a ningún sitio.
    client_max_body_size 1m;
}
